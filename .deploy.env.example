# Copy to .deploy.env (gitignored) and fill in. 

# --- DreamHost (metazoonfts.com) ---
DEPLOY_USER=             # DreamHost shell user
DEPLOY_HOST=             # e.g. vpsNNNNN.dreamhostps.com
DEPLOY_PATH=             # the metazoonfts.com web root, e.g. ~/metazoonfts.com/

# --- Bunny CDN ---
BUNNY_STORAGE_ZONE=      # storage zone name (from metasued/.deploy.env)
BUNNY_STORAGE_KEY=       # storage-zone password 
BUNNY_STORAGE_HOST=
BUNNY_CDN_HOST=
