{
  "name": "metazoonfts",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "dev": "npm run build:data && vite",
    "build": "npm run build:data && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:quiet": "vitest run --silent --reporter=dot",
    "typecheck": "tsc -b --noEmit",
    "verify": "npm run test:quiet && npm run build",
    "deploy": "bash ../scripts/deploy.sh",
    "deploy:dry": "DRY_RUN=1 bash ../scripts/deploy.sh",
    "deploy:site": "SKIP_NGINX=1 bash ../scripts/deploy.sh",
    "deploy:redirects": "DEPLOY_REDIRECTS=1 bash ../scripts/deploy.sh",
    "check:live": "bash ../scripts/check-live.sh",
    "data": "cd .. && .venv/bin/python -m scripts.build_site_data && cd web && npm run build:data",
    "pytest": "cd .. && .venv/bin/python -m pytest -q",
    "audit:pnl": "cd .. && .venv/bin/python -m scripts.audit_wallet_pnl"
  },
  "dependencies": {
    "@google/model-viewer": "3.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.2",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
