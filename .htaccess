# metazoonfts.com - static, fully prerendered site
#
# NOTE: the live host serves this domain with nginx, which ignores 
# .htaccess entirely: nginx/metazoonfts.com/nginx.conf
# Keep the two in sync when changing either.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # www -> non-www (301). Sends straight to https, so an http://www request
  # canonicalises in one hop rather than two
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # http -> https (301) for everything else
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Prerendered directories serve their own index.html
DirectoryIndex index.html

# Anything with no prerendered file -> the prerendered 404 page
ErrorDocument 404 /404.html

# The Sandbox models are served same-origin as Draco-compressed .glb
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
</IfModule>

# Without this the runtime JSON (holders/tokens files run to hundreds of KB)
# and the JS bundle ship uncompressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Fingerprinted build assets are immutable - cache hard. Only the extensions
  # Vite hashes belong here: an unfingerprinted file cached for a year cannot be
  # updated, since its URL never changes.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must revalidate so a new deploy is picked up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Everything served under a fixed name: data and models change with each
  # pipeline run, and the favicon and share card change with a redesign. All
  # revalidate rather than caching for a year under a stale name.
  <FilesMatch "\.(json|glb|svg|ico|png|jpe?g|webp)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
